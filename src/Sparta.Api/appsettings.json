{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "DevExpress.ExpressApp": "Warning",
      "Microsoft.IdentityModel": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ResponseCompression": {
    "Enabled": true,
    "EnableForHttps": true
  },
  "Authentication": {
    "Local": { "Enabled": true },
    "Entra": {
      "Enabled": false,
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "SwaggerClientId": "",
      "RequiredScope": "access_as_user"
    }
  }
}
